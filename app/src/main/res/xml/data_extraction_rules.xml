<?xml version="1.0" encoding="utf-8"?>
<!-- Android auto backup (Android 12+): keep the database and settings in cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
